# GHL Private Integration — create a NEW token (old one was exposed; rotate it), then set
# these in Vercel → Project → Settings → Environment Variables. Never commit real values.
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=UiIMlTlrvkxfxHx5ErG2

# ── Audit Tool v2 (/quote — internal) ─────────────────────────────────────────
# Anthropic API key for the AI photo analysis (server-side only, never NEXT_PUBLIC).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Team passcode gating /quote. Rotating it invalidates every logged-in cookie.
QUOTE_PASSWORD=pick-a-strong-passcode
# GHL user that estimates are sent from (send endpoints require a real userId).
# Defaults to Kenn's user id in code; override here if it changes.
GHL_SENDER_USER_ID=ZsKRE5X4jKKVTElNy1ed
# Optional: residential pipeline. Until BOTH are set, residential quotes skip
# the opportunity step (commercial/multifamily/HOA use the built-in commercial IDs).
# GHL_RESIDENTIAL_PIPELINE_ID=
# GHL_RESIDENTIAL_STAGE_ID=
